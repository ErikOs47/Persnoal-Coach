{
  "name": "formkurve",
  "version": "1.0.0",
  "private": true,
  "description": "Persönlicher Trainingscoach als PWA: Trainingspläne aus Profil und Zielen, automatische Progression, Fortschritts-Tracking.",
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "build:sdk": "esbuild tools/sdk-entry.mjs --bundle --format=esm --minify --platform=browser --outfile=vendor/anthropic-sdk.mjs",
    "serve": "python3 -m http.server 8080"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "esbuild": "0.25.0"
  }
}
